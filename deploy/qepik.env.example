# /etc/qepik/qepik.env (root:qepik, 0640). Server settings for qepik.service.
SITE_URL=https://qepik.az
PORT=3000
HOST=127.0.0.1
DATABASE_PATH=/var/lib/qepik/qepik.db
# Trust X-Forwarded-Proto from nginx so request URLs are https.
VINEXT_TRUST_PROXY=1
# The import cron (instrumentation.ts) runs every minute inside the server.
CRON_ENABLED=1
# The only account that may use /admin.
OWNER_EMAIL=
# Random, at least 32 characters: openssl rand -hex 32
AUTH_SECRET=
# Sign-in codes are e-mailed through Resend (https://resend.com); MAIL_FROM must be on a verified domain.
RESEND_API_KEY=
MAIL_FROM=Qəpik <giris@qepik.az>
